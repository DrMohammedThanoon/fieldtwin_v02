# FieldTwin environment variable NAMES only. Never put real values here.
# No secrets or API keys are required for the open NASA data used by default.
# Copy to .env (git-ignored) only if a variable below becomes necessary.

# Optional: Earthdata Login is used via ~/.netrc or browser login, not this file.
# EARTHDATA_USERNAME=

# Optional: basemap provider key, only if a keyed provider is chosen (prefer keyless)
# VITE_BASEMAP_STYLE_URL=
